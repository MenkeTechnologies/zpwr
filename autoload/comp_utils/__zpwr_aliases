# -*- mode: sh -*-
# vim: set ft=sh:
__zpwr_aliases(){

    local k v

    # Built from the live table, not a cache file: $aliases is already in
    # memory, and a file written before the aliases were defined stayed
    # "fresh" for a month while offering none of them. Rebuilt when the
    # table changes size.
    typeset -ga __aliases_ary
    if (( ${#__aliases_ary} != ${#aliases} )); then
        __aliases_ary=()
        for k v in ${(kv)aliases}; do
            __aliases_ary+=($k:"${(q)v}")
        done
    fi

    # With no matcher (the first matcher-list pass) compadd keeps only words
    # that start with $PREFIX; hand _describe just those. A `:` in $PREFIX
    # would need the escaping the `name:desc` entries use, so it gets them all.
    local -a cands
    if [[ -z $_matcher && $PREFIX != *[:\\]* ]]; then
        cands=( ${(M)__aliases_ary:#${(b)PREFIX}*} )
    else
        cands=( "$__aliases_ary[@]" )
    fi
    _describe -t aliases alias cands
}

__zpwr_aliases "$@"
