# -*- mode: sh -*-
# vim: set ft=sh:

__zpwr_galiases(){

    local galiasesAry
    local k v

    # Built from the live table, not a cache file: $galiases is already in
    # memory, and a file written before the aliases were defined stayed
    # "fresh" for a month while offering none of them. Rebuilt when the
    # table changes size.
    typeset -ga __galiases_ary
    if (( ${#__galiases_ary} != ${#galiases} )); then
        __galiases_ary=()
        for k v in ${(kv)galiases}; do
            __galiases_ary+=($k:"${(q)v}")
        done
    fi

    # With no matcher (the first matcher-list pass) compadd keeps only words
    # that start with $PREFIX; hand _describe just those. A `:` in $PREFIX
    # would need the escaping the `name:desc` entries use, so it gets them all.
    local -a cands
    if [[ -z $_matcher && $PREFIX != *[:\\]* ]]; then
        cands=( ${(M)__galiases_ary:#${(b)PREFIX}*} )
    else
        cands=( "$__galiases_ary[@]" )
    fi
    _describe -t global-aliases 'global alias' cands
}

__zpwr_galiases "$@"
