# -*- mode: sh -*-
# vim: set ft=sh:
function _parameters() {

    # function_body
    local expl pattern tmp pfilt i maxLen ary pre
    local -a fakes faked
    if compset -P '*:'; then
        _history_modifiers p
        return
    fi

    pattern=(-g \*)
    zparseopts -D -K -E g:=pattern

    fakes=()
    faked=()
    if zstyle -a ":completion:${curcontext}:" fake-parameters tmp; then
    for i in "$tmp[@]"; do
        if [[ "$i" = *:* ]]; then
        faked=( "$faked[@]" "$i" )
        else
        fakes=( "$fakes[@]" "$i" )
        fi
    done
    fi

    zstyle -t ":completion:${curcontext}:parameters" prefix-needed &&
    [[ $PREFIX != [_.]* ]] && \
    pfilt='[^_.]'

    typeset -a ary
    maxLen=50
    # With no matcher (the first matcher-list pass) compadd keeps only names
    # that start with $PREFIX: describe just those instead of every parameter.
    [[ -z $_matcher ]] && pre=${(b)PREFIX}
    for i in "${(@M)${(@M)${(@k)parameters[(R)${pattern[2]}~*local*]}:#${~pfilt}*}:#${~pre}*}"; do
        # A hideval parameter ($functions, $commands, $userdirs, ...) never shows
        # its value, and building it walks the whole table: describe its type.
        if [[ $parameters[$i] == *hideval* ]]; then
            ary+=($i:"$parameters[$i]")
        else
            ary+=($i:"${${(P)i}:0:100}")
        fi
    done

    for i in "$fakes[@]"; do
        ary+=($i:"${(P)i:0:100}")
    done

    for i in "${(@)${(@M)faked:#${~pattern[2]}}%%:*}"; do
        ary+=($i:"${(P)i:0:100}")
    done

    _describe -t parameters parameter ary

}

_parameters "$@"
