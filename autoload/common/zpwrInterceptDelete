# -*- mode: sh -*-
# vim: set ft=sh:
function zpwrInterceptDelete(){

    #deleteMatching
    if zpwrExists autopair-delete; then
        autopair-delete
    else
        # Same as zpwrInterceptSurround: without zsh-autopair loaded
        # nothing here deleted anything, so backspace did nothing.
        zle .backward-delete-char
    fi
    zpwrKeySender
}

zpwrInterceptDelete "$@"
