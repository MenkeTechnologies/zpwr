# -*- mode: sh -*-
# vim: set ft=sh:

# Under zshrs, move every registered precmd hook onto the async_precmd
# hook so none of them runs before the prompt paints. zshrs intercepts
# the powerlevel10k theme source and renders from its native engine, so
# no precmd hook holds prompt content -- the async hooks write into the
# shared global param table and the next render picks the values up.
#
# ZPWR_PRECMD_SYNC_HOOKS is the exception list: hooks whose result feeds
# the NEXT command rather than the prompt must stay synchronous.
#
# The reconcile runs in BOTH directions, so a hook named there is pulled
# back out of async_precmd_functions. zpwrBindPrecmd binds well before
# ~/.zpwr/local/.tokens-post.sh is sourced at the wait'0a' turbo slot,
# and a one-way drain would leave a hook the user marked sync stranded
# on the async array forever.
#
# This stays on precmd_functions itself so hooks registered later by
# turbo-loaded plugins (zbrowse, zconvey, zsh-z) get drained too.
function zpwrPrecmdDrain(){

    local -a sync_only back keep rest merged

    sync_only=( ${(z)ZPWR_PRECMD_SYNC_HOOKS} )

    back=( ${async_precmd_functions:*sync_only} )
    keep=( ${precmd_functions:*sync_only} )
    rest=( ${${precmd_functions:|sync_only}:#zpwrPrecmdDrain} )
    (( $#rest || $#back )) || return 0

    merged=( ${async_precmd_functions:|sync_only} $rest )
    async_precmd_functions=( ${(u)merged} )
    merged=( $back $keep )
    precmd_functions=( zpwrPrecmdDrain ${(u)merged} )
}

zpwrPrecmdDrain "$@"
