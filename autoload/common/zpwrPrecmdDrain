# -*- mode: sh -*-
# vim: set ft=sh:

# Under zshrs, move every registered precmd hook onto the async_precmd
# hook so none of them runs before the prompt paints. zshrs renders the
# prompt from its native p10k engine (preprompt_render), not from the
# zsh theme's _p9k_precmd, so draining precmd_functions costs no prompt
# content -- the async hooks write into the shared global param table
# and the next render picks the values up.
#
# This stays on precmd_functions itself so hooks registered later by
# turbo-loaded plugins (zbrowse, zconvey, zsh-z) get drained too.
function zpwrPrecmdDrain(){

    local -a rest merged

    rest=( ${(@)precmd_functions:#zpwrPrecmdDrain} )
    (( $#rest )) || return 0

    merged=( $async_precmd_functions $rest )
    async_precmd_functions=( ${(u)merged} )
    precmd_functions=( zpwrPrecmdDrain )
}

zpwrPrecmdDrain "$@"
