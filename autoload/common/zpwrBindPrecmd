# -*- mode: sh -*-
# vim: set ft=sh:
function zpwrBindPrecmd(){
    # zinit dirs showing in prompt
    unset ___pdir_path ___pdir_orig ___oldcd;

    # zshrs adds an `async_precmd` lifecycle hook with no zsh equivalent:
    # its functions run on the shared worker pool AFTER the prompt is
    # rendered, so they can never stall it. They also run against the
    # SHARED global parameter and function tables, so only hooks named
    # in ZPWR_PRECMD_ASYNC_HOOKS are moved -- see zpwrPrecmdAsync, which
    # stays on precmd_functions and reconciles the two arrays.
    if [[ -n "$ZSHRS_VERSION" ]]; then
        precmd_functions=(
            zpwrPrecmdAsync
            zpwrPrecmd
            ${(@)precmd_functions:#(zpwrPrecmd|zpwrPrecmdAsync)}
        )
        zpwrPrecmdAsync
    else
        precmd_functions=(
            zpwrPrecmd
            ${(@)precmd_functions:#zpwrPrecmd}
        )
    fi

}

zpwrBindPrecmd "$@"
